# Copy to backend/.env and fill in. backend/.env is git-ignored.
# Gnani.ai Vachana API key (sent as the X-API-Key-ID header; never exposed to the browser)
GNANI_API_KEY=
# Optional defaults (the browser can override per request)
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
GNANI_TTS_LANGUAGE=en-IN
# Speech-to-text language(s): en-IN, hi-IN, te-IN, ... or a comma list like en-IN,hi-IN, or indic-auto
GNANI_STT_LANGUAGE=en-IN

# Google Maps Places API key (Nearby Search) - used by /api/places/nearby; never exposed to the browser
GOOGLE_MAPS_API_KEY=
